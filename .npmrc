# 🛡️ Seguridad de dependencias
# Bloquea scripts de instalación automáticos
ignore-scripts=true

engine-strict=true

# 🕒 Regla de las 24 horas (Solo pnpm 10+)
# Evita instalar versiones publicadas hace menos de 1440 minutos
minimum-release-age=1440

# Opcional: Forzar el uso de un archivo lock exacto
frozen-lockfile=true